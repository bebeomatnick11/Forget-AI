require('dotenv').config();

const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const OpenAI = require('openai');

const app = express();
const PORT = process.env.PORT || 3000;

// ============================================================
// OPENAI CLIENT
// ============================================================

const apiKey = process.env.OPENAI_API_KEY;

const openai = apiKey
  ? new OpenAI({
      apiKey: apiKey,
      timeout: 25000,
    })
  : null;

// ============================================================
// SECURITY
// ============================================================

app.use(helmet());

app.use(
  express.json({
    limit: '8kb',
  })
);

// ============================================================
// CORS
// ============================================================

const allowedOrigins = process.env.ALLOWED_ORIGINS || '*';

const corsOptions = {
  origin:
    allowedOrigins === '*'
      ? true
      : allowedOrigins
          .split(',')
          .map((origin) => origin.trim())
          .filter(Boolean),

  methods: ['POST', 'GET'],

  allowedHeaders: [
    'Content-Type',
    'X-Roblox-Player',
  ],
};

app.use(cors(corsOptions));

// ============================================================
// RATE LIMIT
// ============================================================

const limiter = rateLimit({
  windowMs: parseInt(
    process.env.RATE_LIMIT_WINDOW_MS || '60000',
    10
  ),

  max: parseInt(
    process.env.RATE_LIMIT_MAX || '20',
    10
  ),

  standardHeaders: true,
  legacyHeaders: false,

  message: {
    error: 'Too many requests, please try again later.',
  },
});

app.use('/api/', limiter);

// ============================================================
// VALIDATION
// ============================================================

function validatePayload(body) {
  if (!body || typeof body !== 'object') {
    return 'Invalid body';
  }

  if (!Array.isArray(body.messages)) {
    return 'messages required';
  }

  if (body.messages.length === 0) {
    return 'messages cannot be empty';
  }

  if (body.messages.length > 20) {
    return 'Too many messages';
  }

  if (JSON.stringify(body).length > 6000) {
    return 'Payload too large';
  }

  for (const msg of body.messages) {
    if (!msg || typeof msg !== 'object') {
      return 'Invalid message format';
    }

    if (!msg.role || !msg.content) {
      return 'Invalid message format';
    }

    if (
      typeof msg.role !== 'string' ||
      typeof msg.content !== 'string'
    ) {
      return 'Invalid message format';
    }

    // Only allow normal chat roles.
    if (
      !['system', 'user', 'assistant'].includes(msg.role)
    ) {
      return 'Invalid message role';
    }

    if (msg.content.length > 2000) {
      return 'Message content too long';
    }
  }

  return null;
}

// ============================================================
// HEALTH CHECK
// ============================================================

app.get('/health', (req, res) => {
  res.json({
    status: 'ok',
    timestamp: new Date().toISOString(),
  });
});

// ============================================================
// MAIN CHAT ENDPOINT
// ============================================================

app.post('/api/chat', async (req, res) => {
  try {
    // --------------------------------------------------------
    // 1. Check OpenAI configuration
    // --------------------------------------------------------

    if (!openai) {
      console.error(
        '[ERROR] OPENAI_API_KEY is not set in environment'
      );

      return res.status(500).json({
        error: 'Server configuration error',
      });
    }

    // --------------------------------------------------------
    // 2. Validate request
    // --------------------------------------------------------

    const validationError = validatePayload(req.body);

    if (validationError) {
      return res.status(400).json({
        error: validationError,
      });
    }

    // --------------------------------------------------------
    // 3. Player identification
    // --------------------------------------------------------

    const playerId =
      req.headers['x-roblox-player'] || 'unknown';

    // Do NOT log message contents or API keys.
    console.log(
      `[${new Date().toISOString()}] Request from player: ${String(
        playerId
      ).slice(0, 100)}`
    );

    // --------------------------------------------------------
    // 4. Model
    // --------------------------------------------------------

    // The client may optionally request a model,
    // but never provide an API key.
    const model =
      typeof req.body.model === 'string' &&
      req.body.model.length <= 100
        ? req.body.model
        : 'gpt-5-mini';

    // --------------------------------------------------------
    // 5. Temperature
    // --------------------------------------------------------

    let temperature = 0.7;

    if (
      typeof req.body.temperature === 'number' &&
      Number.isFinite(req.body.temperature)
    ) {
      temperature = Math.max(
        0,
        Math.min(req.body.temperature, 2)
      );
    }

    // --------------------------------------------------------
    // 6. Output token limit
    // --------------------------------------------------------

    let maxTokens = 400;

    if (
      Number.isInteger(req.body.max_tokens) &&
      req.body.max_tokens > 0
    ) {
      maxTokens = Math.min(
        req.body.max_tokens,
        600
      );
    }

    // --------------------------------------------------------
    // 7. Call OpenAI
    // --------------------------------------------------------

    const response =
      await openai.chat.completions.create({
        model: model,
        messages: req.body.messages,
        temperature: temperature,
        max_tokens: maxTokens,
      });

    // --------------------------------------------------------
    // 8. Return only required data
    // --------------------------------------------------------

    return res.json({
      choices: response.choices,
      usage: response.usage || null,
    });

  } catch (err) {
    console.error(
      '[OpenAI Proxy Error]',
      err?.message || 'Unknown error'
    );

    // Don't expose internal error details or API credentials.
    if (err?.status) {
      return res.status(502).json({
        error: 'AI service temporarily unavailable',
      });
    }

    return res.status(500).json({
      error: 'Internal server error',
    });
  }
});

// ============================================================
// 404
// ============================================================

app.use((req, res) => {
  res.status(404).json({
    error: 'Not found',
  });
});

// ============================================================
// GLOBAL ERROR HANDLER
// ============================================================

app.use((err, req, res, next) => {
  console.error(
    '[Server Error]',
    err?.message || 'Unknown error'
  );

  res.status(500).json({
    error: 'Internal server error',
  });
});

// ============================================================
// START SERVER
// ============================================================

app.listen(PORT, () => {
  console.log(
    `Secure OpenAI Proxy running on port ${PORT}`
  );

  if (!process.env.OPENAI_API_KEY) {
    console.warn(
      'WARNING: OPENAI_API_KEY is not set!'
    );
  } else {
    console.log(
      'OpenAI API key loaded from environment.'
    );
  }
});
