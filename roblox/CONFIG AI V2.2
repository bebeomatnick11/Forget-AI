local function BuildContext()
	return {
		playerName = LocalPlayer.Name,
		aiName = Personalization.Name,
		personality = Personalization.Personality,
		playerPos = RootPart and {x = math.floor(RootPart.Position.X), y = math.floor(RootPart.Position.Y), z = math.floor(RootPart.Position.Z)} or nil,
		aiPos = AIRoot and {x = math.floor(AIRoot.Position.X), y = math.floor(AIRoot.Position.Y), z = math.floor(AIRoot.Position.Z)} or nil,
		distance = (RootPart and AIRoot) and math.floor((RootPart.Position - AIRoot.Position).Magnitude) or nil,
		isFollowing = IsFollowing,
		currentAction = CurrentAction,
		memory = Memory,
	}
end

local function CallAI(userMessage, isFeedback)
	if IsThinking then return end
	IsThinking = true
	ShowThinkingBubble(1)

	local context = BuildContext()
	local personalityText = PersonalityPrompts[Personalization.Personality] or PersonalityPrompts["Trung lập"]

	local systemPrompt = string.format([[
Bạn là AI Companion trong Roblox. Tên bạn là %s.
Bạn đang chơi cùng người chơi tên %s.

Tính cách hiện tại của bạn: %s
%s

Bạn PHẢI trả lời bằng JSON duy nhất:
{
  "reply": "câu trả lời bằng tiếng Việt ngắn gọn, tự nhiên",
  "action": "TÊN_ACTION"
}

Các action hợp lệ: FOLLOW_PLAYER, STOP, JUMP, SIT, TELEPORT_NEAR, SAY, IDLE

Context:
%s
]], Personalization.Name, LocalPlayer.Name, Personalization.Personality, personalityText, HttpService:JSONEncode(context))

	local messages = {{role = "system", content = systemPrompt}}
	for _, h in ipairs(ChatHistory) do
		table.insert(messages, {
			role = h.role == "You" and "user" or "assistant",
			content = h.text
		})
	end
	table.insert(messages, {role = "user", content = userMessage})

	local body = {
		model = CONFIG.MODEL,
		messages = messages,
		temperature = 0.7,
		max_tokens = 400,
	}

	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = CONFIG.BACKEND_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["X-Roblox-Player"] = tostring(LocalPlayer.UserId),
			},
			Body = HttpService:JSONEncode(body),
		})
	end)

	IsThinking = false

	if not success or not response or response.StatusCode \~= 200 then
		ShowBubble("Xin lỗi, tôi không kết nối được server.", 4)
		AddChatMessage("AI", "Xin lỗi, lỗi kết nối backend.")
		return
	end

	local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
	if not ok or not decoded or not decoded.choices or not decoded.choices[1] then
		ShowBubble("Lỗi xử lý phản hồi.", 3)
		return
	end

	local content = decoded.choices[1].message.content
	local actionData
	local parseOk, parsed = pcall(function()
		local jsonStr = content:match("%{.-%}")
		if jsonStr then return HttpService:JSONDecode(jsonStr) end
		return {reply = content, action = "SAY"}
	end)

	actionData = (parseOk and parsed) and parsed or {reply = content, action = "SAY"}
	local reply = actionData.reply or actionData.message or "..."

	if #Memory > 8 then table.remove(Memory, 1) end
	table.insert(Memory, {user = userMessage, ai = reply})

	AddChatMessage("AI", reply, true) -- true = hiện nút góp ý
	ShowBubble(reply, 5)
	ExecuteAction(actionData)
end

