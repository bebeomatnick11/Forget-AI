	local function SendMessage()
		local text = InputBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" or IsThinking then return end
		InputBox.Text = ""
		AddChatMessage("You", text)
		StatusLabel.Text = "Đang suy nghĩ..."
		StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		task.spawn(function()
			CallAI(text)
			StatusLabel.Text = "Sẵn sàng • " .. Personalization.Personality
			StatusLabel.TextColor3 = Color3.fromRGB(140, 200, 140)
		end)
	end

	SendBtn.MouseButton1Click:Connect(SendMessage)
	InputBox.FocusLost:Connect(function(enter) if enter then SendMessage() end end)

	-- Responsive
	local function UpdateLayout()
		local cam = workspace.CurrentCamera
		if not cam then return end
		if cam.ViewportSize.X < 700 then
			MainFrame.Size = UDim2.new(0.92, 0, 0.68, 0)
			MainFrame.Position = UDim2.new(0.04, 0, 0.18, 0)
			ToggleBtn.Position = UDim2.new(1, -70, 1, -140)
		else
			MainFrame.Size = UDim2.new(0, 340, 0, 460)
			MainFrame.Position = UDim2.new(1, -360, 1, -490)
		end
	end
	UpdateLayout()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateLayout)
end

