--==========================================================
-- UTILS
--==========================================================
local function SafeDestroy(obj)
	if obj and obj.Parent then pcall(function() obj:Destroy() end) end
end

local function Create(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do obj[k] = v end
	return obj
end

--==========================================================
-- ANIMATION
--==========================================================
local AnimationTracks = {}
local CurrentAnimState = "Idle"

local DefaultAnims = {
	Idle = "rbxassetid://507766666",
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
	Climb = "rbxassetid://507765644",
	Sit = "rbxassetid://507768133",
	Swim = "rbxassetid://913384386",
	SwimIdle = "rbxassetid://913390859",
}

local function LoadAnimations(animator)
	AnimationTracks = {}
	for name, id in pairs(DefaultAnims) do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Movement
			if name == "Idle" or name == "Walk" or name == "Run" or name == "Swim" or name == "SwimIdle" then
				track.Looped = true
			end
			AnimationTracks[name] = track
		end
	end
end

local function PlayAnim(name, fade)
	if not AnimationTracks[name] or CurrentAnimState == name then return end
	if AnimationTracks[CurrentAnimState] and AnimationTracks[CurrentAnimState].IsPlaying then
		AnimationTracks[CurrentAnimState]:Stop(fade or 0.2)
	end
	AnimationTracks[name]:Play(fade or 0.2)
	CurrentAnimState = name
end

local function UpdateAnimation()
	if not AIHumanoid or not AIRoot then return end
	local state = AIHumanoid:GetState()
	local speed = AIRoot.AssemblyLinearVelocity.Magnitude

	if state == Enum.HumanoidStateType.Jumping then PlayAnim("Jump")
	elseif state == Enum.HumanoidStateType.Freefall then PlayAnim("Fall")
	elseif state == Enum.HumanoidStateType.Climbing then PlayAnim("Climb")
	elseif state == Enum.HumanoidStateType.Swimming then
		PlayAnim(speed > 2 and "Swim" or "SwimIdle")
	elseif state == Enum.HumanoidStateType.Seated then PlayAnim("Sit")
	elseif speed > 16 then PlayAnim("Run")
	elseif speed > 1 then PlayAnim("Walk")
	else PlayAnim("Idle") end
end

