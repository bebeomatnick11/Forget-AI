local function CreateAICharacter()
	if AICharacter then SafeDestroy(AICharacter) end

	local source = LocalPlayer.Character
	if not source then return end

	local success, cloned = pcall(function() return source:Clone() end)
	if not success or not cloned then
		warn("[AI] Không clone được character")
		return
	end

	cloned.Name = Personalization.Name
	cloned.Parent = workspace

	for _, desc in ipairs(cloned:GetDescendants()) do
		if desc:IsA("LocalScript") or desc:IsA("Script") or desc:IsA("Tool") then
			desc:Destroy()
		end
	end

	local clonedHum = cloned:FindFirstChildOfClass("Humanoid")
	local clonedRoot = cloned:FindFirstChild("HumanoidRootPart")
	if not clonedHum or not clonedRoot then
		SafeDestroy(cloned)
		return
	end

	clonedHum.DisplayName = Personalization.Name
	clonedHum.Health = 100
	clonedHum.MaxHealth = 100
	clonedHum.WalkSpeed = 16
	clonedHum.JumpPower = 50

	local oldAnimate = cloned:FindFirstChild("Animate")
	if oldAnimate then oldAnimate:Destroy() end

	local anim = clonedHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", clonedHum)

	local offset = Vector3.new(4, 0, 0)
	clonedRoot.CFrame = source.HumanoidRootPart.CFrame * CFrame.new(offset)

	pcall(function() clonedRoot:SetNetworkOwner(LocalPlayer) end)

	AICharacter = cloned
	AIHumanoid = clonedHum
	AIRoot = clonedRoot
	AIAnimator = anim

	LoadAnimations(AIAnimator)
	PlayAnim("Idle")

	-- Name tag
	local billboard = Create("BillboardGui", {
		Name = "AINameTag",
		Size = UDim2.new(0, 200, 0, 40),
		StudsOffset = Vector3.new(0, 3.2, 0),
		AlwaysOnTop = true,
		Parent = AIRoot
	})
	Create("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = Personalization.Name,
		TextColor3 = Color3.fromRGB(100, 200, 255),
		TextStrokeTransparency = 0.4,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		Parent = billboard
	})
end

