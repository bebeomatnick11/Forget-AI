local function ShowBubble(text, duration)
	duration = duration or 4
	if tick() - LastBubbleTime < CONFIG.BUBBLE_COOLDOWN then return end
	LastBubbleTime = tick()

	if CurrentBubble then SafeDestroy(CurrentBubble) end
	if not AIRoot then return end

	local billboard = Create("BillboardGui", {
		Name = "AIBubble",
		Size = UDim2.new(0, 280, 0, 80),
		StudsOffset = Vector3.new(0, 4.5, 0),
		AlwaysOnTop = true,
		MaxDistance = 80,
		Parent = AIRoot
	})

	local frame = Create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(30, 30, 40),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = billboard
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = frame})
	Create("UIStroke", {Color = Color3.fromRGB(80, 160, 255), Thickness = 1.5, Parent = frame})

	Create("TextLabel", {
		Size = UDim2.new(1, -16, 1, -12),
		Position = UDim2.new(0, 8, 0, 6),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color3.fromRGB(240, 240, 255),
		Font = Enum.Font.Gotham,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame
	})

	CurrentBubble = billboard
	task.delay(duration, function()
		if CurrentBubble == billboard then
			SafeDestroy(billboard)
			CurrentBubble = nil
		end
	end)
end

local function ShowThinkingBubble(stage)
	if stage == 1 then ShowBubble("🤔 Đang suy nghĩ...", 8)
	elseif stage == 2 then ShowBubble("🤔 Đang phân tích...", 10)
	else ShowBubble("...", 6) end
end

--==========================================================
-- PATHFINDING + FOLLOW
--==========================================================
local function ComputePath(targetPos)
	if not AIRoot then return nil end
	local path = PathfindingService:CreatePath({
		AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, AgentCanClimb = true, WaypointSpacing = 4
	})
	local ok = pcall(function() path:ComputeAsync(AIRoot.Position, targetPos) end)
	if ok and path.Status == Enum.PathStatus.Success then return path end
	return nil
end

local function FollowPlayer()
	if not IsFollowing or not AIRoot or not RootPart then return end
	local dist = (AIRoot.Position - RootPart.Position).Magnitude

	if dist >= CONFIG.TELEPORT_DISTANCE then
		local offset = RootPart.CFrame.RightVector * 4 + Vector3.new(0, 0, -2)
		local safePos = RootPart.Position + offset
		local ray = workspace:Raycast(safePos + Vector3.new(0, 10, 0), Vector3.new(0, -30, 0))
		if ray then safePos = ray.Position + Vector3.new(0, 3, 0) end
		AIRoot.CFrame = CFrame.new(safePos)
		AIHumanoid:MoveTo(RootPart.Position)
		return
	end

	if dist <= CONFIG.FOLLOW_DISTANCE then
		AIHumanoid:MoveTo(AIRoot.Position)
		IsMoving = false
		return
	end

	local target = RootPart.Position - (RootPart.CFrame.LookVector * 2)
	local path = ComputePath(target)
	if path then
		CurrentPath = path
		Waypoints = path:GetWaypoints()
		if #Waypoints > 1 then
			AIHumanoid:MoveTo(Waypoints[2].Position)
			IsMoving = true
		end
	else
		AIHumanoid:MoveTo(RootPart.Position)
		IsMoving = true
	end
end

local function CheckStuck()
	if not AIRoot or not IsFollowing then return end
	if not LastPosition then LastPosition = AIRoot.Position return end
	local moved = (AIRoot.Position - LastPosition).Magnitude
	LastPosition = AIRoot.Position

	if moved < CONFIG.STUCK_THRESHOLD and IsMoving then
		StuckTimer = StuckTimer + CONFIG.STUCK_CHECK_INTERVAL
		if StuckTimer > 3 then
			AIHumanoid.Jump = true
			task.wait(0.4)
			FollowPlayer()
			StuckTimer = 0
		end
	else
		StuckTimer = 0
	end
end

--==========================================================
-- ACTION CONTROLLER
--==========================================================
local ValidActions = {
	FOLLOW_PLAYER = true, STOP = true, JUMP = true, SIT = true,
	TELEPORT_NEAR = true, SAY = true, IDLE = true
}

local function ExecuteAction(actionData)
	if type(actionData) \~= "table" then return end
	local action = tostring(actionData.action or ""):upper()
	if not ValidActions[action] then return end
	CurrentAction = action

	if action == "FOLLOW_PLAYER" then
		IsFollowing = true
		ShowBubble("Được, tôi đi theo bạn!", 3)
		FollowPlayer()
	elseif action == "STOP" then
		IsFollowing = false
		IsMoving = false
		if AIHumanoid then AIHumanoid:MoveTo(AIRoot.Position) end
		ShowBubble("Ok, tôi dừng lại.", 3)
	elseif action == "JUMP" then
		if AIHumanoid then AIHumanoid.Jump = true end
		ShowBubble("Nhảy!", 2)
	elseif action == "SIT" then
		if AIHumanoid then AIHumanoid.Sit = true end
		ShowBubble("Ngồi đây.", 3)
	elseif action == "TELEPORT_NEAR" then
		if RootPart and AIRoot then
			AIRoot.CFrame = CFrame.new(RootPart.Position + RootPart.CFrame.RightVector * 3)
		end
	elseif action == "SAY" then
		local msg = actionData.message or actionData.text or ""
		if msg \~= "" then
			ShowBubble(msg, 5)
			AddChatMessage("AI", msg)
		end
	elseif action == "IDLE" then
		IsFollowing = false
		IsMoving = false
	end
end

