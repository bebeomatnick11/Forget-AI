local function CreateAICharacter()
	if AICharacter then
		SafeDestroy(AICharacter)
	end

	local source = LocalPlayer.Character
	if not source then
		return
	end

	local ok, cloned = pcall(function()
		return source:Clone()
	end)
	if not ok or not cloned then
		return
	end

	cloned.Name = Personalization.Name
	cloned.Parent = workspace

	for _, d in ipairs(cloned:GetDescendants()) do
		if d:IsA("LocalScript") or d:IsA("Script") or d:IsA("Tool") then
			d:Destroy()
		end
	end

	local hum = cloned:FindFirstChildOfClass("Humanoid")
	local root = cloned:FindFirstChild("HumanoidRootPart")
	if not hum or not root then
		SafeDestroy(cloned)
		return
	end

	hum.DisplayName = Personalization.Name
	hum.Health = 100
	hum.MaxHealth = 100
	hum.WalkSpeed = 16
	hum.JumpPower = 50

	local oldAnimate = cloned:FindFirstChild("Animate")
	if oldAnimate then
		oldAnimate:Destroy()
	end

	local anim = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)

	root.CFrame = source.HumanoidRootPart.CFrame * CFrame.new(4, 0, 0)
	pcall(function()
		root:SetNetworkOwner(LocalPlayer)
	end)

	AICharacter = cloned
	AIHumanoid = hum
	AIRoot = root
	AIAnimator = anim

	LoadAnimations(AIAnimator)
	PlayAnim("Idle")

	local billboard = Create("BillboardGui", {
		Name = "AINameTag",
		Size = UDim2.new(0, 200, 0, 40),
		StudsOffset = Vector3.new(0, 3.2, 0),
		AlwaysOnTop = true,
		Parent = AIRoot
	})
	Create("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = Personalization.Name,
		TextColor3 = Color3.fromRGB(100, 200, 255),
		TextStrokeTransparency = 0.4,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		Parent = billboard
	})
end

