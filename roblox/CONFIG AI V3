local function BuildContext()
	return {
		playerName = LocalPlayer.Name,
		aiName = Personalization.Name,
		personality = Personalization.Personality,
		language = Personalization.Language,
		playerPos = RootPart and {
			x = math.floor(RootPart.Position.X),
			y = math.floor(RootPart.Position.Y),
			z = math.floor(RootPart.Position.Z)
		} or nil,
		aiPos = AIRoot and {
			x = math.floor(AIRoot.Position.X),
			y = math.floor(AIRoot.Position.Y),
			z = math.floor(AIRoot.Position.Z)
		} or nil,
		distance = (RootPart and AIRoot) and math.floor((RootPart.Position - AIRoot.Position).Magnitude) or nil,
		isFollowing = IsFollowing,
		currentAction = CurrentAction,
	}
end

local function CallAI(userMessage)
	if IsThinking then
		return
	end
	IsThinking = true

	ShowThinkingBubble()

	local context = BuildContext()

	local languageInstruction = LanguagePrompts[Personalization.Language] or LanguagePrompts["Tiếng Việt"]
	local personalityText = PersonalityPrompts[Personalization.Personality] or PersonalityPrompts["Trung lập"]

	local instruction = string.format([[
Bạn là AI Companion trong Roblox tên "%s".

Tính cách:
%s

%s

Bạn PHẢI trả về DUY NHẤT một JSON hợp lệ.
Không markdown.
Không ```json.
Không giải thích bên ngoài JSON.

Định dạng chính xác:

{
  "reply": "câu trả lời ngắn gọn",
  "action": "ACTION"
}

Các action hợp lệ:

FOLLOW_PLAYER
STOP
JUMP
SIT
TELEPORT_NEAR
SAY
IDLE

Quy tắc action:

- Người chơi bảo đi theo → FOLLOW_PLAYER
- Người chơi bảo dừng → STOP
- Người chơi bảo nhảy → JUMP
- Người chơi bảo ngồi → SIT
- Người chơi bảo lại gần/teleport → TELEPORT_NEAR
- Chỉ trò chuyện bình thường → SAY
- Không cần hành động → IDLE

Không được tạo action khác.

Người chơi nói:
%s
]], Personalization.Name, personalityText, languageInstruction, userMessage)

	local body = {
		message = instruction,
		playerId = tostring(LocalPlayer.UserId),
		context = HttpService:JSONEncode(context),
	}

	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = CONFIG.BACKEND_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = HttpService:JSONEncode(body),
		})
	end)

	IsThinking = false

	if not success or not response then
		ShowBubble("❌ Không kết nối được AI server.", 4)
		AddChatMessage("AI", "Lỗi kết nối backend.")
		return
	end

	if response.StatusCode ~= 200 then
		local serverError = "Backend HTTP " .. tostring(response.StatusCode)

		local errorOk, errorData = pcall(function()
			return HttpService:JSONDecode(response.Body)
		end)

		if errorOk and type(errorData) == "table" then
			serverError = tostring(errorData.error or serverError)
		end

		ShowBubble("❌ " .. serverError, 5)
		AddChatMessage("AI", serverError)
		return
	end

	local decodeOk, decoded = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)

	if not decodeOk or type(decoded) ~= "table" then
		ShowBubble("❌ Backend trả dữ liệu không hợp lệ.", 4)
		AddChatMessage("AI", "Phản hồi backend không hợp lệ.")
		return
	end

	if decoded.ok ~= true then
		local err = tostring(decoded.error or "AI gặp lỗi.")
		ShowBubble("❌ " .. err, 4)
		AddChatMessage("AI", err)
		return
	end

	local rawReply = tostring(decoded.reply or "")

	if rawReply == "" then
		ShowBubble("AI không trả lời.", 3)
		AddChatMessage("AI", "Không nhận được câu trả lời.")
		return
	end

	--======================================================
	-- PARSE AI JSON
	--======================================================
	local actionData = {
		reply = rawReply,
		action = "SAY",
	}

	local parseOk, parsed = pcall(function()
		return HttpService:JSONDecode(rawReply)
	end)

	if parseOk and type(parsed) == "table" then
		if parsed.reply ~= nil then
			actionData.reply = tostring(parsed.reply)
		end
		if parsed.action ~= nil then
			actionData.action = tostring(parsed.action):upper()
		end
	else
		local jsonStr = rawReply:match("{.*}")
		if jsonStr then
			local retryOk, retryParsed = pcall(function()
				return HttpService:JSONDecode(jsonStr)
			end)
			if retryOk and type(retryParsed) == "table" then
				if retryParsed.reply ~= nil then
					actionData.reply = tostring(retryParsed.reply)
				end
				if retryParsed.action ~= nil then
					actionData.action = tostring(retryParsed.action):upper()
				end
			end
		end
	end

	--======================================================
	-- VALIDATE ACTION
	--======================================================
	if not ValidActions[actionData.action] then
		actionData.action = "SAY"
	end

	local reply = actionData.reply
	local action = actionData.action

	--======================================================
	-- MEMORY
	--======================================================
	if #Memory >= 8 then
		table.remove(Memory, 1)
	end
	table.insert(Memory, {
		user = userMessage,
		ai = reply,
	})

	--======================================================
	-- DISPLAY
	--======================================================
	AddChatMessage("AI", reply, true)
	ShowBubble(reply, 5)

	--======================================================
	-- ACTION
	--======================================================
	ExecuteAction(action)
end

