--==========================================================
-- PATHFINDING + FOLLOW
--==========================================================
local function ComputePath(targetPos)
	if not AIRoot then
		return nil
	end
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		AgentCanClimb = true,
		WaypointSpacing = 4,
	})
	local ok = pcall(function()
		path:ComputeAsync(AIRoot.Position, targetPos)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		return path
	end
	return nil
end

local function FollowPlayer()
	if not IsFollowing or not AIRoot or not RootPart then
		return
	end
	local dist = (AIRoot.Position - RootPart.Position).Magnitude

	if dist >= CONFIG.TELEPORT_DISTANCE then
		local offset = RootPart.CFrame.RightVector * 4 + Vector3.new(0, 0, -2)
		local safePos = RootPart.Position + offset
		local ray = workspace:Raycast(safePos + Vector3.new(0, 10, 0), Vector3.new(0, -30, 0))
		if ray then
			safePos = ray.Position + Vector3.new(0, 3, 0)
		end
		AIRoot.CFrame = CFrame.new(safePos)
		AIHumanoid:MoveTo(RootPart.Position)
		return
	end

	if dist <= CONFIG.FOLLOW_DISTANCE then
		AIHumanoid:MoveTo(AIRoot.Position)
		IsMoving = false
		return
	end

	local target = RootPart.Position - (RootPart.CFrame.LookVector * 2)
	local path = ComputePath(target)
	if path then
		local waypoints = path:GetWaypoints()
		if #waypoints > 1 then
			AIHumanoid:MoveTo(waypoints[2].Position)
			IsMoving = true
		end
	else
		AIHumanoid:MoveTo(RootPart.Position)
		IsMoving = true
	end
end

local function CheckStuck()
	if not AIRoot or not IsFollowing then
		return
	end
	if not LastPosition then
		LastPosition = AIRoot.Position
		return
	end

	local moved = (AIRoot.Position - LastPosition).Magnitude
	LastPosition = AIRoot.Position

	if moved < CONFIG.STUCK_THRESHOLD and IsMoving then
		StuckTimer = StuckTimer + CONFIG.STUCK_CHECK_INTERVAL
		if StuckTimer > 3 then
			AIHumanoid.Jump = true
			task.wait(0.4)
			FollowPlayer()
			StuckTimer = 0
		end
	else
		StuckTimer = 0
	end
end

--==========================================================
-- ACTION CONTROLLER
--==========================================================
local ValidActions = {
	FOLLOW_PLAYER = true,
	STOP = true,
	JUMP = true,
	SIT = true,
	TELEPORT_NEAR = true,
	SAY = true,
	IDLE = true,
}

local function ExecuteAction(actionName)
	local action = tostring(actionName or ""):upper()
	if not ValidActions[action] then
		return
	end
	CurrentAction = action

	if action == "FOLLOW_PLAYER" then
		IsFollowing = true
		ShowBubble(Personalization.Language == "English" and "Okay, I'll follow you!" or "Được, tôi đi theo bạn!", 3)
		FollowPlayer()
	elseif action == "STOP" then
		IsFollowing = false
		IsMoving = false
		if AIHumanoid then
			AIHumanoid:MoveTo(AIRoot.Position)
		end
		ShowBubble(Personalization.Language == "English" and "Okay, I'll stop." or "Ok, tôi dừng lại.", 3)
	elseif action == "JUMP" then
		if AIHumanoid then
			AIHumanoid.Jump = true
		end
		ShowBubble(Personalization.Language == "English" and "Jump!" or "Nhảy!", 2)
	elseif action == "SIT" then
		if AIHumanoid then
			AIHumanoid.Sit = true
		end
		ShowBubble(Personalization.Language == "English" and "Sitting down." or "Ngồi đây.", 3)
	elseif action == "TELEPORT_NEAR" then
		if RootPart and AIRoot then
			AIRoot.CFrame = CFrame.new(RootPart.Position + RootPart.CFrame.RightVector * 3)
		end
	elseif action == "IDLE" then
		IsFollowing = false
		IsMoving = false
	end
end

