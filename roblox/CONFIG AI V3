local function SafeDestroy(obj)
	if obj and obj.Parent then
		pcall(function()
			obj:Destroy()
		end)
	end
end

local function Create(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	return obj
end

